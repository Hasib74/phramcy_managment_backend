{
  "name": "pharmacy-os-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Enterprise Pharmacy Business Operating System Backend & Microservices Engine",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:gateway": "tsx watch src/gateway/server.ts",
    "dev:auth": "tsx watch src/services/auth-service/server.ts",
    "dev:inventory": "tsx watch src/services/product-inventory-service/server.ts",
    "dev:pos": "tsx watch src/services/pos-sales-service/server.ts",
    "dev:procurement": "tsx watch src/services/procurement-service/server.ts",
    "dev:accounting": "tsx watch src/services/accounting-service/server.ts",
    "dev:hr": "tsx watch src/services/hr-payroll-service/server.ts",
    "dev:orders": "tsx watch src/services/order-delivery-service/server.ts",
    "dev:reports": "tsx watch src/services/reports-bi-service/server.ts",
    "dev:microservices": "concurrently -n \"GATEWAY,AUTH,INV,POS,PROC,ACC,HR,ORD,REP\" -c \"cyan,blue,green,yellow,magenta,red,gray,white,blueBright\" \"npm run dev:gateway\" \"npm run dev:auth\" \"npm run dev:inventory\" \"npm run dev:pos\" \"npm run dev:procurement\" \"npm run dev:accounting\" \"npm run dev:hr\" \"npm run dev:orders\" \"npm run dev:reports\"",
    "migrate": "tsx src/database/migrate.ts",
    "seed": "tsx src/database/seed.ts",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "pharmacy",
    "pos",
    "inventory",
    "fefo",
    "saas",
    "multi-tenant",
    "microservices",
    "api-gateway",
    "winston",
    "erp",
    "accounting",
    "postgresql",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^3.0.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.3",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
