# Server Configuration
NODE_ENV=development
PORT=5050
API_PREFIX=/api/v1

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medical_inventory_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_MAX_POOL=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=5000

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_3984729384729384
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_9823749823749823
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=10

# CORS Allowed Origins
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
